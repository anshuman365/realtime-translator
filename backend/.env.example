# Backend Environment Variables
# Copy this file to .env and update with your values

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./translation_app.db
# For PostgreSQL: postgresql://user:password@localhost/translator_db

# API Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# Model Paths
VOSK_MODEL_PATH=./models/vosk
PIPER_VOICE_PATH=./models/piper
HF_CACHE_DIR=./models/huggingface

# Performance Settings
MAX_CONCURRENT_SESSIONS=20
AUDIO_CHUNK_DURATION_MS=200
STT_SAMPLE_RATE=16000

# Optional Cloud API Keys (not required for offline mode)
GOOGLE_API_KEY=
AZURE_API_KEY=

# Production Settings (for Render deployment)
# PORT=8000
# PYTHON_VERSION=3.11
